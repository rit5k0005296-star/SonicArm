  "notebook_cells": {
    "03a_pool_compatible_all55_diagnostic.ipynb": [
      "from pathlib import Path\nimport json, os, platform, subprocess, sys, uuid\nsys.dont_write_bytecode=True\nROOT=Path.cwd().resolve()\nassert (ROOT/'compatible_all55.py').is_file(), '\u8bf7\u5c06\u8865\u4e01\u5185\u5bb9\u5408\u5e76\u5230full_model_test'\nassert platform.system()=='Linux' and platform.machine().lower() in ('armv7l','armv8l')\nRUN=ROOT/'test_results'/('compatible_all55_'+uuid.uuid4().hex)\nRUN.mkdir(parents=True)\ndef execute_stage(stage):\n    destination=RUN/stage\n    destination.mkdir()\n    command=[sys.executable,'-B',str(ROOT/'compatible_all55.py'),'--stage',stage,'--output',str(destination)]\n    if stage=='fpga':\n        gate=RUN/'cpu/correctness.json'\n        assert gate.is_file(), '\u8bf7\u5148\u8fd0\u884cCPU\u8bca\u65ad'\n        prerequisite=json.loads(gate.read_text())\n        assert prerequisite.get('diagnostic_completed') and prerequisite.get('software_reconstruction_gate'), '\u8f6f\u4ef6\u91cd\u5efa\u5931\u8d25\uff0c\u4e0d\u52a0\u8f7dFPGA'\n        command+=['--cpu-report',str(gate)]\n    try:\n        proc=subprocess.run(command,cwd=str(ROOT),text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,\n            timeout=900,env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'})\n        output=proc.stdout\n        returncode=proc.returncode\n    except subprocess.TimeoutExpired as error:\n        output=error.stdout or ''\n        if isinstance(output,bytes):\n            output=output.decode('utf-8',errors='replace')\n        output+='\\n\u8d85\u8fc7900\u79d2\uff0c\u505c\u6b62\u5e76\u8fd4\u56de\u65e5\u5fd7\uff1b\u82e5\u53d1\u751f\u786c\u4ef6\u8d85\u65f6\uff0c\u8bf7\u91cd\u542f\u677f\u5361\u540e\u518d\u7ee7\u7eed\u3002'\n        returncode=-1\n    (destination/'execution.log').write_text(output,encoding='utf-8')\n    print(output)\n    print('\u8fd4\u56de\u7801:',returncode,'\u7ed3\u679c\u76ee\u5f55:',destination)\n    assert returncode==0, '\u672c\u9636\u6bb5\u672a\u901a\u8fc7\uff0c\u8bf7\u8fd4\u56de\u5b8c\u6574\u8f93\u51fa\uff0c\u4e0d\u7ee7\u7eed\u4e0b\u4e00\u683c'\nprint('\u672c\u6b21\u7ed3\u679c\u76ee\u5f55:',RUN)\n",
      "execute_stage('cpu')\n",
      "execute_stage('fpga')\n"
    ]
  },
