  "notebook_cells": {
    "00_environment_probe.ipynb": [
      "import sys\nfrom pathlib import Path\nsys.dont_write_bytecode=True\nROOT=Path.cwd().resolve()\nassert (ROOT/'probe_environment.py').is_file()\nsys.path.insert(0,str(ROOT))\nfrom probe_environment import probe\nprobe_dir=probe()",
      "import json\nreport=json.loads((probe_dir/'environment.json').read_text())\nprint(json.dumps(report['gate'],ensure_ascii=False,indent=2))\nprint('将此目录的 environment.json 返回桌面分析:',probe_dir)"
    ],
    "00a_prepare_audio_dependencies.ipynb": [
      "import sys, json, uuid, ctypes, ctypes.util, importlib.util\nfrom pathlib import Path\nsys.dont_write_bytecode=True\nROOT=Path.cwd().resolve()\nassert (ROOT/'runtime_core.py').is_file(), '请在 full_model_test 目录中打开此 Notebook'\nDEPS=ROOT/'_board_deps'\nsys.path.insert(0,str(DEPS))\nLOG=ROOT/'dependency_results'/('soundfile_'+uuid.uuid4().hex)\nLOG.mkdir(parents=True)\nsndfile=ctypes.util.find_library('sndfile')\nreport={'python':sys.executable,'cffi_available':False,'libsndfile':sndfile,'native_library_loadable':False}\ntry:\n    import cffi\n    cffi.FFI()\n    report['cffi_available']=True\n    report['cffi_version']=cffi.__version__\nexcept Exception as error:\n    report['cffi_error']=repr(error)\ntry:\n    if sndfile:\n        ctypes.CDLL(sndfile)\n        report['native_library_loadable']=True\nexcept Exception as error:\n    report['libsndfile_error']=repr(error)\n(LOG/'prerequisites.json').write_text(json.dumps(report,indent=2),encoding='utf-8')\nprint(json.dumps(report,ensure_ascii=False,indent=2))\nprint('日志目录:',LOG)\nassert report['cffi_available'] and report['native_library_loadable'], '前置依赖缺失：把以上完整输出返回；先不要运行下个单元格'\n",
      "import subprocess, os\nDEPS.mkdir(exist_ok=True)\ncommand=[sys.executable,'-B','-m','pip','install','--disable-pip-version-check',\n         '--no-cache-dir','--no-deps','--target',str(DEPS),'soundfile==0.12.1']\n# --no-deps 避免修改已验证的NumPy；不调用sudo、不修改板卡公共Python环境。\nproc=subprocess.run(command,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,\n                    env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'})\n(LOG/'install.log').write_text(proc.stdout,encoding='utf-8')\nprint(proc.stdout)\nassert proc.returncode==0, '安装未完成：返回完整输出，不要继续'\n",
      "# 在新子进程中验证，避免Notebook已经导入的模块缓存干扰。\nscript=\"\"\"\nfrom runtime_core import *\nimport soundfile as sf\nprint('soundfile',sf.__version__,'libsndfile',sf.__libsndfile_version__)\nprotocol=json.loads((BUNDLE/'smoke_protocol.json').read_text())\nrows=[]\nfor audio in protocol['audio']:\n    f,timing=frontend(BUNDLE/audio['path'],'numpy16k')\n    ref=np.load(BUNDLE/audio['features'],allow_pickle=False)\n    assert f.shape==ref.shape, 'Fbank shape mismatch'\n    d=np.abs(f-ref)\n    row={'audio':audio['id'],'shape':list(f.shape),'max_abs':float(d.max()),'mean_abs':float(d.mean())}\n    rows.append(row)\n    print(row,flush=True)\n    assert d.max()<=1e-4 and d.mean()<=1e-5, 'Fbank equivalence gate failed'\nprint('NUMPY_FRONTEND_PASS: 3/3. Full CPU/FPGA still requires ONNX Runtime.')\n\"\"\"\nproc=subprocess.run([sys.executable,'-B','-c',script],cwd=str(ROOT),text=True,\n    stdout=subprocess.PIPE,stderr=subprocess.STDOUT,env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'})\n(LOG/'frontend_validation.log').write_text(proc.stdout,encoding='utf-8')\nprint(proc.stdout)\nassert proc.returncode==0, '前处理仍未通过：返回完整输出'\nprint('这一步完成。返回此输出后，再处理匹配ARMv7/Python3.10的完整模型运行库。')\n"
    ],
    "00b_install_soundfile_offline.ipynb": [
      "from pathlib import Path\nimport ctypes, ctypes.util, hashlib, json, os, subprocess, sys, uuid\nsys.dont_write_bytecode=True\nROOT=Path.cwd().resolve()\nassert (ROOT/'runtime_core.py').is_file(), '请在full_model_test目录中打开此Notebook'\nDEPS=ROOT/'_board_deps'\nsys.path.insert(0,str(DEPS))\nimport numpy as np\nimport cffi\ncffi.FFI()\nnative=ctypes.util.find_library('sndfile')\nassert native, '系统libsndfile未找到，停止并返回输出'\nctypes.CDLL(native)\nWHEEL=ROOT/'offline_packages'/'soundfile-0.12.1-py2.py3-none-any.whl'\nassert WHEEL.is_file(), '缺少离线wheel：请把offline_packages文件夹也复制进full_model_test'\nassert hashlib.sha256(WHEEL.read_bytes()).hexdigest()=='828a79c2e75abab5359f780c81dccd4953c45a2c4cd4f05ba3e233ddf984b882', 'wheel哈希不匹配'\nLOG=ROOT/'dependency_results'/('offline_soundfile_'+uuid.uuid4().hex)\nLOG.mkdir(parents=True)\nprint('Python:',sys.executable,'NumPy:',np.__version__,'CFFI:',cffi.__version__,'libsndfile:',native)\ncommand=[sys.executable,'-B','-m','pip','install','--disable-pip-version-check',\n    '--no-index','--no-deps','--no-compile','--no-cache-dir','--upgrade',\n    '--target',str(DEPS),str(WHEEL)]\nproc=subprocess.run(command,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,\n    env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'})\n(LOG/'install.log').write_text(proc.stdout,encoding='utf-8')\nprint(proc.stdout)\nassert proc.returncode==0, '离线安装失败：保留输出，不要运行后续单元格'\nprint('OFFLINE_INSTALL_PASS；继续运行下一个验证单元格。日志:',LOG)\n",
      "script=\"from runtime_core import *\\nimport soundfile as sf\\nprint('soundfile',sf.__version__,'location',sf.__file__,'libsndfile',sf.__libsndfile_version__)\\nprint('NumPy',np.__version__)\\nassert sf.__version__=='0.12.1'\\nprotocol=json.loads((BUNDLE/'smoke_protocol.json').read_text())\\nfor audio in protocol['audio']:\\n    f,timing=frontend(BUNDLE/audio['path'],'numpy16k')\\n    ref=np.load(BUNDLE/audio['features'],allow_pickle=False)\\n    assert f.shape==ref.shape, 'Fbank形状不一致'\\n    d=np.abs(f-ref)\\n    print(audio['id'],'shape',f.shape,'max_abs',float(d.max()),'mean_abs',float(d.mean()),flush=True)\\n    assert d.max()<=1e-4 and d.mean()<=1e-5, 'Fbank数值门控失败'\\nprint('NUMPY_FRONTEND_PASS: 3/3')\\n\"\nproc=subprocess.run([sys.executable,'-B','-c',script],cwd=str(ROOT),text=True,\n    stdout=subprocess.PIPE,stderr=subprocess.STDOUT,env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'})\n(LOG/'frontend_validation.log').write_text(proc.stdout,encoding='utf-8')\nprint(proc.stdout)\nassert proc.returncode==0, '验证失败：返回完整输出'\nprint('本阶段完成。将本单元格输出返回，继续解决ONNX Runtime；现在还不进入01/FPGA。')\n"
    ],
    "00c_native_ort_cpu_gate.ipynb": [
      "from pathlib import Path\nimport ctypes, json, os, platform, subprocess, sys, uuid\nsys.dont_write_bytecode=True\nROOT=Path.cwd().resolve()\nassert (ROOT/'native_backend_probe.py').is_file(), '请在full_model_test目录中打开00c'\nassert platform.system()=='Linux' and platform.machine().lower() in ('armv7l','armv8l')\nassert ctypes.sizeof(ctypes.c_void_p)==4, '此共享库仅供ARM32 Linux'\nsys.path.insert(0,str(ROOT))\nfrom runtime_core import verify_manifest\nprint('包版本:',verify_manifest())\nLOG=ROOT/'dependency_results'/('native_ort_'+uuid.uuid4().hex)\nLOG.mkdir(parents=True)\nprint('本次结果目录:',LOG)\nprint('下一单元格会执行完整模型；In [*] 时请等待，不要重复启动。')\n",
      "command=[sys.executable,'-B',str(ROOT/'native_backend_probe.py'),'--output',str(LOG)]\ntry:\n    proc=subprocess.run(command,cwd=str(ROOT),text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,\n        timeout=900,env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'})\n    output=proc.stdout\n    code=proc.returncode\nexcept subprocess.TimeoutExpired as error:\n    output=error.stdout or ''\n    if isinstance(output,bytes):\n        output=output.decode('utf-8',errors='replace')\n    output+='\\n执行超过900秒，已停止此子进程；保留日志返回分析。'\n    code=-1\n(LOG/'native_ort_execution.log').write_text(output,encoding='utf-8')\nprint(output)\nprint('进程返回码:',code,'结果目录:',LOG)\nassert code==0, '完整CPU门控未通过：返回完整输出，先不要运行01/FPGA'\nprint('请将以上输出返回，特别是DESKTOP_REFERENCE_GATE和SOFTWARE_INTEGER_ONE_GATE。')\n"
